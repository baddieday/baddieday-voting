{
  "$comment": "Zentrale Schnittliste einer Session (sessions/<ID>/schnittliste.json). Wird vor dem Speichern geprüft.",
  "type": "object",
  "required": ["version", "session", "entschieden_von", "match", "clips", "warnungen", "ohne_video"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "enum": [2]},
    "session": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "entschieden_von": {"type": "string", "enum": ["claude", "regel"]},
    "gewichte_version": {"type": "integer", "minimum": 0},
    "match": {
      "type": "object",
      "required": ["kills", "kill_quelle", "victory_royale"],
      "properties": {
        "replay": {"type": ["string", "null"]},
        "build": {"type": ["string", "null"]},
        "platzierung": {"type": ["integer", "null"], "minimum": 1},
        "victory_royale": {"type": "boolean"},
        "kills": {"type": "integer", "minimum": 0},
        "kill_quelle": {"type": "string", "enum": ["replay", "steelseries", "nvidia", "keine"]}
      }
    },
    "warnungen": {"type": "array", "items": {"type": "string"}},
    "ohne_video": {"type": "array", "items": {"type": "object"}},
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nr", "titel", "typ", "kills", "max_gruppe", "victory_royale", "kill_zeiten_utc",
                     "kill_sekunden", "aufnahme", "quelle", "start_s", "ende_s", "merkmale", "punkte", "begruendung"],
        "additionalProperties": false,
        "properties": {
          "nr": {"type": "integer", "minimum": 1},
          "titel": {"type": "string", "minLength": 1},
          "typ": {"type": "string", "enum": ["einzel", "double", "triple", "multi"]},
          "kills": {"type": "integer", "minimum": 1},
          "max_gruppe": {"type": "integer", "minimum": 1},
          "victory_royale": {"type": "boolean"},
          "kill_zeiten_utc": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "kill_sekunden": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "aktion_sekunden": {"type": "array", "minItems": 1, "items": {"type": "number"},
                              "$comment": "parallel zu kill_sekunden: mein Umhauen je Kill (Sekunde in der Aufnahme, darf < 0 sein)"},
          "aufnahme": {"type": "string", "minLength": 1},
          "quelle": {"type": "string"},
          "start_s": {"type": "number", "minimum": 0},
          "ende_s": {"type": "number", "minimum": 0},
          "min_start_s": {"type": "number", "minimum": 0},
          "max_ende_s": {"type": "number", "minimum": 0},
          "abdeckung": {"type": "number", "minimum": 0, "maximum": 1},
          "merkmale": {"type": "object"},
          "punkte": {"type": "number"},
          "begruendung": {"type": "string"},
          "beschreibung": {"type": ["string", "null"], "maxLength": 150},
          "grund": {"type": ["string", "null"]}
        }
      }
    }
  }
}
