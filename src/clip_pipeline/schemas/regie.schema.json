{
  "$comment": "Schnittliste des Regisseurs (pipeline compose). Wird vor dem Speichern geprüft (regie.pruefe_liste). version 4: Effekt-Plan (effekte.py); version 3 ohne Effekte bleibt gültig.",
  "type": "object",
  "required": ["version", "art", "name", "format", "aufloesung", "fps", "dauer_s", "stimmung", "parameter",
               "musik", "overlay", "bogen", "segmente", "hinweise", "erstellt"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "enum": [3, 4]},
    "art": {"type": "string", "enum": ["regie"]},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "format": {"type": "string", "enum": ["zusammenschnitt", "short"]},
    "aufloesung": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 16}},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "dauer_s": {"type": "number", "minimum": 0},
    "stimmung": {"type": "string", "enum": ["episch", "lustig", "spannend", "frustriert", "chill"]},
    "parameter": {"type": "object"},
    "musik": {
      "type": ["object", "null"],
      "required": ["track_id", "datei", "titel", "quelle", "bpm", "start_s", "pegel"],
      "properties": {
        "track_id": {"type": "integer"},
        "datei": {"type": "string", "minLength": 1},
        "titel": {"type": "string", "minLength": 1},
        "kuenstler": {"type": ["string", "null"]},
        "quelle": {"type": "string", "minLength": 1},
        "bpm": {"type": ["number", "null"]},
        "start_s": {"type": "number", "minimum": 0},
        "pegel": {"type": "number", "minimum": 0, "maximum": 1},
        "wertung": {"type": "object"}
      }
    },
    "overlay": {"type": ["string", "null"]},
    "effekte": {
      "$comment": "Regisseur 2.0: an = false heißt ohne jeden Effekt (wie version 3)",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["an"],
      "properties": {
        "an": {"type": "boolean"},
        "profil_version": {"type": "integer", "minimum": 1, "maximum": 99},
        "look": {"type": "string", "enum": ["neutral", "cinematic", "kalt", "warm", "entsaettigt", "soft"]},
        "look_staerke": {"type": "number", "minimum": 0, "maximum": 1},
        "hook": {"type": "boolean"},
        "loop": {"type": "boolean"}
      }
    },
    "bogen": {"type": "array", "items": {"type": "number"}},
    "auswahl": {
      "type": "object",
      "properties": {
        "kandidaten": {"type": "integer", "minimum": 0},
        "neu": {"type": "integer", "minimum": 0},
        "schon_gezeigt": {"type": "integer", "minimum": 0},
        "abwechslung": {"type": "number", "minimum": 0}
      }
    },
    "hinweise": {"type": "array", "items": {"type": "string"}},
    "gelernt": {"type": "object", "additionalProperties": false, "required": ["entwurf", "aenderungen"],
                "properties": {"entwurf": {"type": "integer", "minimum": 1}, "format": {"type": ["string", "null"]},
                               "aenderungen": {"type": "array", "items": {"type": "string"}}}},
    "erstellt": {"type": "string"},
    "segmente": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["nr", "moment", "datei", "stimmung", "quelle_start_s", "quelle_ende_s", "quelle_dauer_s",
                     "muss", "zeit_start", "zeit_ende", "uebergang"],
        "additionalProperties": false,
        "properties": {
          "nr": {"type": "integer", "minimum": 1},
          "moment": {"type": "string", "minLength": 1},
          "teil": {"type": "integer", "minimum": 1, "$comment": "Jump-Cut: n-ter Teil desselben Moments (fehlt = ein Stück)"},
          "clip_id": {"type": ["integer", "null"]},
          "match_id": {"type": ["string", "null"]},
          "datei": {"type": "string", "minLength": 1},
          "stimmung": {"type": "string", "enum": ["episch", "lustig", "spannend", "frustriert", "chill"]},
          "stimmen": {"type": "boolean"},
          "intensitaet": {"type": "number"},
          "grund": {"type": "string"},
          "punkte": {"type": "number"},
          "abzug": {"type": "number", "minimum": 0},
          "gezeigt": {"type": "integer", "minimum": 0},
          "bewertet": {"type": "integer", "minimum": 0},
          "quelle_start_s": {"type": "number", "minimum": 0},
          "quelle_ende_s": {"type": "number", "minimum": 0},
          "quelle_dauer_s": {"type": "number", "minimum": 0},
          "muss": {"type": "array", "minItems": 2, "items": {"type": "number"}},
          "zeit_start": {"type": "number", "minimum": 0},
          "zeit_ende": {"type": "number", "minimum": 0},
          "auf_beat": {"type": "boolean"},
          "rolle": {"type": "string", "enum": ["moment", "hook"]},
          "kill_s": {"type": "array", "maxItems": 20, "items": {"type": "number", "minimum": 0},
                     "$comment": "sichtbare eigene Kills (Anker: mein Umhauen, sonst der Kill) in Quellsekunden"},
          "lupe": {
            "$comment": "Zeitlupe in Quellzeit (effekte.plane_tempo): die Zeitleiste dehnt sich um (bis−ab)·(1/faktor−1)",
            "type": ["object", "null"],
            "required": ["ab_s", "bis_s", "faktor", "ton"],
            "additionalProperties": false,
            "properties": {
              "ab_s": {"type": "number", "minimum": 0},
              "bis_s": {"type": "number", "minimum": 0},
              "faktor": {"type": "number", "enum": [0.25, 0.5]},
              "ton": {"type": "string", "enum": ["tief", "tempo", "stumm"]}
            }
          },
          "raffer": {
            "$comment": "Zeitraffer im Anlauf (effekte.plane_tempo), liegt vor der Zeitlupe; die Zeitleiste staucht sich um (bis−ab)·(1−1/faktor)",
            "type": ["object", "null"],
            "required": ["ab_s", "bis_s", "faktor", "ton"],
            "additionalProperties": false,
            "properties": {
              "ab_s": {"type": "number", "minimum": 0},
              "bis_s": {"type": "number", "minimum": 0},
              "faktor": {"type": "number", "enum": [1.5, 2.0]},
              "ton": {"type": "string", "enum": ["tief", "tempo", "stumm"]}
            }
          },
          "effekte": {
            "$comment": "Effekt-Plan (effekte.plane): t_s = Quellzeit, dauer_s = Dauer im Video. Im Spielbild: Zoom/Drift und der Katalog (effekte.BILD, 28.09.); Texte nie im Spielbild",
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "required": ["art", "t_s", "staerke"],
              "additionalProperties": false,
              "properties": {
                "art": {"type": "string", "enum": ["punch", "akzent", "meme", "shake", "tilt", "einzug", "drift_ein", "drift_aus",
                                                    "flash", "strobe", "farbpop", "kontrast", "hue", "negativ", "blur", "pixel",
                                                    "vignette", "rgb", "titel", "zaehler", "sfx"]},
                "t_s": {"type": "number", "minimum": 0},
                "dauer_s": {"type": "number", "minimum": 0, "maximum": 30},
                "staerke": {"type": "number", "minimum": 0, "maximum": 1},
                "text": {"type": "string", "enum": ["DOUBLE KILL", "TRIPLE KILL", "QUAD KILL", "PENTA KILL", "MULTI KILL",
                                                     "VICTORY ROYALE"]},
                "zahl": {"type": "integer", "minimum": 1, "maximum": 99},
                "klang": {"type": "string", "enum": ["basshit", "tick", "whoosh", "pop", "einschlag", "riser"]}
              }
            }
          },
          "uebergang": {
            "type": "object",
            "required": ["art", "dauer_s"],
            "additionalProperties": false,
            "properties": {
              "art": {"type": "string", "enum": ["schnitt", "fade", "fadeblack", "fadewhite", "wipeleft", "wiperight", "wipeup",
                                                  "wipedown", "slideleft", "slideright", "slideup", "slidedown", "circleopen",
                                                  "circleclose", "radial", "smoothleft", "smoothright", "smoothup", "smoothdown",
                                                  "diagtl", "diagbr", "hblur", "squeezev", "coverleft", "revealright",
                                                  "whip", "whip_up", "whip_right", "zoom", "glitch", "squeeze", "dissolve", "flash"],
                      "$comment": "whip*, zoom, glitch, squeeze, dissolve, flash sind eigene Namen – die ffmpeg-Art bestimmt der Renderer (effekt_filter.XFADE)"},
              "dauer_s": {"type": "number", "minimum": 0, "maximum": 3}
            }
          }
        }
      }
    }
  }
}
