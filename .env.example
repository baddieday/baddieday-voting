# Kopiere diese Datei nach .env und trage die Werte ein. .env steht in .gitignore.

# Token vom @BotFather
TELEGRAM_BOT_TOKEN=

# Deine Telegram-User-ID (z. B. über @userinfobot). Nur diese ID darf den Bot bedienen.
TELEGRAM_ALLOWED_USER_ID=

# Lern-Bot des Regisseurs (eigener Bot vom @BotFather – NICHT derselbe Token wie oben)
LEARN_BOT_TOKEN=
# Optional: andere Telegram-ID für den Lern-Bot (sonst gilt TELEGRAM_ALLOWED_USER_ID)
# LEARN_BOT_ALLOWED_USER_ID=

# Deine Epic-ID für die Replay-Auswertung (zeigt `pipeline replay <datei>` an). Steht bewusst nicht in
# config/pipeline.toml, weil das Repo öffentlich ist. Leer = automatische Erkennung.
CLIP_EPIC_ID=

# Optional: andere Konfigurationsdatei, Speicher-Wurzel oder Datenbank (praktisch zum Testen)
# CLIP_KONFIG=config/pipeline.toml
# CLIP_SPEICHER=/srv/clips
# CLIP_DATENBANK=/var/lib/clip-pipeline/pipeline.db
