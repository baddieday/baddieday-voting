# Kopiere diese Datei nach .env und trage die Werte ein. .env steht in .gitignore.

# Token vom @BotFather
TELEGRAM_BOT_TOKEN=

# Deine Telegram-User-ID (z. B. über @userinfobot). Nur diese ID darf den Bot bedienen.
TELEGRAM_ALLOWED_USER_ID=

# Lern-Bot des Regisseurs (eigener Bot vom @BotFather – NICHT derselbe Token wie oben)
LEARN_BOT_TOKEN=
# Optional: andere Telegram-ID für den Lern-Bot (sonst gilt TELEGRAM_ALLOWED_USER_ID)
# LEARN_BOT_ALLOWED_USER_ID=

# Deine Epic-ID für die Replay-Auswertung (zeigt `pipeline replay <datei>` an). Steht bewusst nicht in
# config/pipeline.toml, weil das Repo öffentlich ist. Leer = automatische Erkennung.
CLIP_EPIC_ID=

# Optional: andere Konfigurationsdatei, Speicher-Wurzel oder Datenbank (praktisch zum Testen)
# CLIP_KONFIG=config/pipeline.toml
# CLIP_SPEICHER=/srv/clips
# CLIP_DATENBANK=/var/lib/clip-pipeline/pipeline.db

# Optionale offizielle Publikums-APIs. Nur eigene autorisierte Videos werden
# abgerufen, automatisch durch den vorhandenen clip-publikum-Timer.
# TikTok Display: Scope video.list. Liefert keine Watchtime und keine Saves.
# Einfachster Weg (30.09.): nur CLIENT_KEY und CLIENT_SECRET setzen, dann im Lern-Bot /tiktok –
# die Tokens landen in der privaten publikum-oauth.json und werden selbst erneuert.
# Alternativ: ein Access-Token allein (24 h) oder alle drei Refresh-Werte von Hand.
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# Rotierte TikTok-Tokens: private publikum-oauth.json neben der DB, nie committen.

# YouTube Analytics: Scope https://www.googleapis.com/auth/yt-analytics.readonly
# ACCESS_TOKEN oder alle drei Refresh-Werte für dauerhaft automatischen Zugriff.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Freund-Instanz (Mehrbenutzer M1): Vorlage für /var/lib/clip-benutzer/<name>/.env ------------------------------
# Gehört root (root:clip-<name>, 0640). Erlaubt sind dort nur Zugänge (TELEGRAM_*, LEARN_BOT_*, TIKTOK_*, YOUTUBE_*,
# CLIP_EPIC_ID, CLAUDE_CODE_OAUTH_TOKEN), sonst startet nichts (Exit 2); Werte von Florian erbt ein Freund nie.
# Für Stufe 1 reichen diese – sie bleiben hier auskommentiert, für Florians .env gelten sie nicht:
# LEARN_BOT_TOKEN=
#     eigener Bot vom @BotFather, nie Florians Token
# LEARN_BOT_ALLOWED_USER_ID=
#     Telegram-Zahl des Freundes – trägt benutzer-anlegen.sh selbst ein, sobald er den Einladungslink antippt
# CLIP_EPIC_ID=
#     Epic-Konto-ID des Freundes (Pflicht)
# CLAUDE_CODE_OAUTH_TOKEN=
#     optional: sein eigener Claude-Zugang, erzeugt mit `claude setup-token` in SEINEM Abo; ohne bleibt die KI aus.
#     Einfacher: /claude in seinem Bot (schreibt I/db/claude-token, das geht vor)
