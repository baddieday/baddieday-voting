#!/usr/bin/env bash
# pve-mini (Host, NICHT im CT): schreibt den Füllstand des Thin-Pools für die Morgenprüfung der Pipeline (E19).
# Läuft alle 15 min (clip-lvm-status.timer), installiert von puffer-einrichten.sh nach /usr/local/sbin/.
# Datei: /mnt/big/lvm-status.txt – im CT /srv/big/lvm-status.txt ([puffer].pool_status). /mnt/big ist ein lokaler
#   Ordner des Hosts (nur /mnt/big/clips darunter ist das NFS von pve-big) – das Schreiben weckt also niemanden.
# Format, eine Zeile je Wert:  zeit=<ISO, UTC>  data_prozent=<float>  meta_prozent=<float>  root_frei_gb=<int>
# Nur lesen (lvs, df). Die Datei wird atomar ersetzt (Zwischendatei + mv): die Pipeline liest nie eine halbe.
set -euo pipefail
export LC_ALL=C                              # Dezimalpunkt statt Komma
POOL="${POOL:-pve/data}"
DATEI="${DATEI:-/mnt/big/lvm-status.txt}"

werte="$(lvs --noheadings --nosuffix -o data_percent,metadata_percent "$POOL")"
read -r data meta <<< "$werte"
for w in "${data:-}" "${meta:-}"; do
  [[ "$w" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "lvs $POOL lieferte Unerwartetes: '$werte'" >&2; exit 1; }
done
frei="$(df -BG --output=avail / | tail -n 1 | tr -dc '0-9')"
[ -n "$frei" ] || { echo "df / lieferte keinen freien Platz" >&2; exit 1; }

tmp="$(mktemp "$(dirname "$DATEI")/.lvm-status.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
printf 'zeit=%s\ndata_prozent=%s\nmeta_prozent=%s\nroot_frei_gb=%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$data" "$meta" "$frei" > "$tmp"
chmod 644 "$tmp"                             # im CT liest pipeline mit (dort eine fremde UID)
mv -f "$tmp" "$DATEI"
