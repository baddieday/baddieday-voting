# Lager eines Freundes (Mehrbenutzer, Stufe 2, docs/MEHRBENUTZER.md „Lager für Freunde“) – Vorlage, %i = sein Name.
# Sein täglicher Abgleich Puffer -> Lager, derselbe Code wie bei Florian (pipeline lager abgleich): Datenbank sichern,
# jede neue Datei nach freunde/<name> auf pve-big kopieren und mit SHA-256 zurücklesen, Rohdaten dort nie
# überschreiben; danach gibt sein Puffer Rohvideos frei, die älter als 14 Tage und im Lager bestätigt sind (der erste
# Lauf zählt nur). Im Lager wird nie etwas gelöscht. Weckt nie (kein Host, keine MAC, kein SSH in seiner Konfig).
# Kein Timer: Gestartet wird er nur vom Rundgang clip-lager-freunde.service, der bei Florians Abgleich mitfährt, wenn
# pve-big ohnehin wach ist – je Freund nacheinander, nur 10–18 Uhr.
# 3 = pve-big ging aus bzw. Lager nicht eingehängt, 4 = sein Abgleich läuft schon -> kein Fehler, nächstes Mal.
# 2 = falscher Ordner oder kein NFS -> nichts kopiert, nichts gelöscht (bitte ansehen).
# Installiert: alles-aktualisieren.sh legt die Vorlage nur auf die Platte, sobald es einen Freund gibt – eingeschaltet
# wird das Lager je Freund nur über benutzer-anlegen.sh <name> (Schritt „Lager“, bei wachem pve-big).
# Log ansehen: journalctl -u clip-freund-lager@<name> -n 50
[Unit]
Description=Clip-Pipeline: Puffer von %i ins Lager (Freund)

[Service]
Type=oneshot
ExecStart=/opt/clip-pipeline/.venv/bin/pipeline lager abgleich
SuccessExitStatus=3 4
# Je Freund höchstens 2 h (so lange hält der Rundgang pve-big für ihn wach); abgebrochen bleiben nur .teil-Reste,
# nichts ist bestätigt – der nächste Lauf macht weiter
TimeoutStartSec=2h
# Nur nebenbei: Platte im Leerlauf-Vorrang (Prozessor mit halbem Vorrang und Nice 10 aus der Sandbox)
IOSchedulingClass=idle
# --- Sandbox: in jeder Vorlage wörtlich gleich (tests/test_deploy_benutzer.py) ---
# Eigener Benutzer clip-<name>, nur sein Ordner I = /var/lib/clip-benutzer/<name> (CLIP_INSTANZ). Seine Zugänge liest
# die Pipeline selbst aus I/.env – kein EnvironmentFile, kein CLIP_PROJEKT. HOME und Caches (Whisper-Modell) in I/cache.
User=clip-%i
Group=clip-%i
Environment=CLIP_INSTANZ=/var/lib/clip-benutzer/%i
Environment=HOME=/var/lib/clip-benutzer/%i/cache
Environment=XDG_CACHE_HOME=/var/lib/clip-benutzer/%i/cache
Environment=HF_HOME=/var/lib/clip-benutzer/%i/cache/huggingface
WorkingDirectory=/opt/clip-pipeline
# Rendern braucht die iGPU (VA-API): Gruppe render. Freunde rechnen mit halbem Vorrang und höchstens 3 GB Speicher.
SupplementaryGroups=render
Nice=10
CPUWeight=50
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
# Alles nur lesbar; /home und /root gibt es nicht (dort liegen Florians Claude-Anmeldung und seine Schlüssel)
ProtectSystem=strict
ProtectHome=true
# Fremde Prozesse unsichtbar: Befehlszeilen von Florian und anderen Freunden (z. B. die Epic-ID beim Replay-Lesen)
# sieht der Freund nicht. Kann der Container das nicht, bleibt es ohne Wirkung – der Dienst startet trotzdem (M19).
ProtectProc=invisible
# Leere, schreibgeschützte Ordner über Florians Bereichen und allen Freunden: Puffer, Lager, Datenbank, claude,
# Schlüssel für pve-big, lokal.toml und die Ordner der anderen gibt es hier gar nicht …
TemporaryFileSystem=/srv:ro /var/lib/clip-pipeline:ro /var/lib/clip-benutzer:ro /opt/clip-pipeline/config:ro
# … eingebunden werden nur der eigene Ordner (schreibbar), die EINE Rechen-Sperre des Mini (Florians Datei, nur lesen –
# flock wirkt trotzdem) und das Startwissen pipeline.toml. Fehlt eins davon, startet der Dienst nicht.
BindPaths=/var/lib/clip-benutzer/%i
BindReadOnlyPaths=/var/lib/clip-pipeline/pipeline.lock /opt/clip-pipeline/config/pipeline.toml
# Florians Zugänge und sein Lern-Bot-Stand („-“: fehlt eins davon, startet der Dienst trotzdem)
InaccessiblePaths=-/opt/clip-pipeline/.env -/opt/clip-regie
# --- Ende Sandbox ---
# --- Lager: genau diese Bindung, nur in diesem Dienst (tests/test_deploy_benutzer.py) ---
# Sein Unterordner im Lager (NFS von pve-big) erscheint als I/lager – sonst nichts vom Lager, nicht Florians Ordner,
# nicht die anderen Freunde. Ohne „-“: Fehlt der Ordner (pve-big schläft, NFS nicht eingehängt), startet nichts.
BindPaths=/srv/big/clips/freunde/%i:/var/lib/clip-benutzer/%i/lager
# Kein Netz: Das NFS liest und schreibt der Kernel, der Abgleich selbst braucht keins
PrivateNetwork=yes
