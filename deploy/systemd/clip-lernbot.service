# Lern-Bot des Regisseurs (eigener Token LEARN_BOT_TOKEN in .env). Getrennt vom Clip-Bot (clip-bot.service).
# Installieren:  sudo cp deploy/systemd/clip-lernbot.service /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now clip-lernbot
# Log ansehen:   journalctl -u clip-lernbot -f
[Unit]
Description=Clip-Pipeline Lern-Bot (Regisseur)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pipeline
WorkingDirectory=/opt/clip-pipeline
ExecStart=/opt/clip-pipeline/.venv/bin/pipeline lernbot
Restart=always
RestartSec=10
# Rendern braucht die iGPU (VA-API): Gruppe render
SupplementaryGroups=render
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /srv/puffer ausdrücklich (E19): Nach dem Umschalten (docs/PUFFER.md, R5) ist /srv/clips nur ein Link darauf –
# systemd löst ihn sonst nur implizit beim Start auf. "-": fehlt /srv/puffer (vor R1), startet der Dienst trotzdem.
ReadWritePaths=/var/lib/clip-pipeline /srv/clips -/srv/puffer

[Install]
WantedBy=multi-user.target
